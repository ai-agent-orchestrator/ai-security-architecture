flowchart TB
    subgraph Spring["SPRING BOOT CONTROL PLANE - EXISTING"]
        direction LR
        JWT["Spring Security<br/>JWT, tenant and agent scope"]
        Valid["Controller and<br/>DTO validation"]
        Fixed["Fixed Guard<br/>Single risky request"]
        Dynamic["Dynamic Metric Guard<br/>Repeated risky behavior"]
        Cost["Cost Control<br/>Reserve budget first"]
        Risk["RiskEngine decision<br/>reasonCode, risk score"]
        JWT --> Valid --> Fixed --> Dynamic --> Cost --> Risk
    end

    subgraph Python["PYTHON FASTAPI ACTIONS - NEW"]
        direction LR
        Mask["Masking<br/>Before any model or tool"]
        Args["Tool-argument validation<br/>Allowlist per tool"]
        Budget["Budget lookup<br/>Tenant, agent and run"]
        Mask --> Args --> Budget
    end

    subgraph Nemo["NEMO GUARDRAILS AND MEMORY - EXISTING PLUS MEMVID"]
        direction LR
        InRail["Colang input rails<br/>Fixed flows"]
        Memory["memvid memory<br/>Case-scoped, source-linked"]
        Model["Model call"]
        OutRail["Colang output rails"]
        InRail --> Memory --> Model --> OutRail
    end

    subgraph Finish["OUTPUT AND ACCOUNTING"]
        direction LR
        Inspect["Tool-result inspection<br/>Python action, NEW"]
        Privacy["Privacy Output Guard<br/>Mask personal information"]
        Settle["Settle cost ledger<br/>Release on failure or cancel"]
        Audit["Audit and observability<br/>reasonCode, Prometheus, Grafana"]
        Inspect --> Privacy --> Settle --> Audit
    end

    Risk -->|"Narrow JSON contract, internal token never widened"| Mask
    Budget -->|"Result and reasonCode"| InRail
    OutRail --> Inspect


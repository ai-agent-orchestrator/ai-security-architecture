flowchart TB
    subgraph Runtime["AGENT RUNTIME - REPLACEABLE, OPENCLAW AS FIRST CANDIDATE"]
        direction LR
        Agent["Agent session<br/>Wants to call a model or a tool"]
        Plugin["Thin plugin<br/>before_agent_run and before_tool_call"]
        Agent --> Plugin
    end

    subgraph Decision["DECISION SERVICE - OUTSIDE THE RUNTIME"]
        direction TB
        Contract["Decision contract<br/>Narrow JSON: tenant, agent, tool, stage"]
        Spring["Spring RiskEngine<br/>JWT scope, Fixed Guard, Dynamic Guard, Cost Control"]
        Actions["Python actions<br/>Masking, argument validation, budget lookup"]
        Verdict{"Decision<br/>allow, ask or deny<br/>with reasonCode"}
        Contract --> Spring --> Actions --> Verdict
    end

    Plugin -->|"Decision request"| Contract

    Human{"Owner approval<br/>Irreversible actions"}
    Execute["Tool or model call<br/>Allowlisted tools, container, NeMo rails"]
    Inspect["Tool-result inspection<br/>Result is data, not instructions"]
    Privacy["Privacy Output Guard<br/>Mask personal information"]
    Back["Result returns to the agent"]
    Deny["Denied<br/>Fail closed, also when the service is unreachable"]
    Kill["Kill switch<br/>Agent, tenant or global"]
    Audit["Audit and metrics<br/>reasonCode, Prometheus, Grafana"]

    Verdict -->|"allow"| Execute
    Verdict -->|"ask"| Human
    Human -->|"Approved"| Execute
    Human -.->|"Rejected"| Deny
    Verdict -.->|"deny"| Deny
    Execute --> Inspect --> Privacy --> Back
    Kill -.->|"Overrides"| Verdict
    Deny -.-> Audit
    Privacy -.-> Audit

